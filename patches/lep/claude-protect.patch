+BOOL WINAPI LepGetThreadPreferredUILanguages(
+    DWORD Flags,
+    PULONG NumberOfLanguages,
+    PWSTR LanguagesBuffer,
+    PULONG BufferLength
+)
+{
+    // KernelBase may serve this list from its private per-thread MUI cache
+    // without calling RtlGetThreadPreferredUILanguages with public flags.
+    // Cover the Win32 boundary as well, including merged user/system lists.
+    return LepGetPreferredUILanguages(Flags, NumberOfLanguages, LanguagesBuffer, BufferLength);
+}
