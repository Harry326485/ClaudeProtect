+static BOOL WINAPI LepGetPreferredUILanguages(
+    DWORD Flags,
+    PULONG NumberOfLanguages,
+    PWSTR LanguagesBuffer,
+    PULONG BufferLength
+)
+{
+    constexpr DWORD MuiLanguageId = 0x4;
+    constexpr DWORD MuiLanguageName = 0x8;
+    constexpr LCTYPE LocaleSName = 0x0000005C;
+
+    PLepGlobalData GlobalData = LepGetGlobalData();
+    LCID LocaleId = GlobalData->GetEnvironment()->LocaleId;
+    WCHAR Name[LOCALE_NAME_MAX_LENGTH] = {};
+    if (GetLocaleInfoW(LocaleId, LocaleSName, Name, countof(Name)) == 0)
+        return FALSE;
+
+    WCHAR Id[5] = {};
+    PCWSTR Source = Name;
+    if ((Flags & MuiLanguageId) != 0)
+    {
+        static const WCHAR HexDigits[] = L"0123456789ABCDEF";
+        LANGID Language = LANGIDFROMLCID(LocaleId);
+        Id[0] = HexDigits[(Language >> 12) & 0xF];
+        Id[1] = HexDigits[(Language >> 8) & 0xF];
+        Id[2] = HexDigits[(Language >> 4) & 0xF];
+        Id[3] = HexDigits[Language & 0xF];
+        Id[4] = 0;
+        Source = Id;
+    }
+    else if ((Flags & MuiLanguageName) == 0 && Flags != 0)
+    {
+        return FALSE;
+    }
+
+    ULONG Length = (ULONG)StrLengthW(Source);
+    ULONG Required = Length + 2;
+    ULONG Capacity = BufferLength != nullptr ? *BufferLength : 0;
+    if (NumberOfLanguages != nullptr)
+        *NumberOfLanguages = 1;
+    if (BufferLength != nullptr)
+        *BufferLength = Required;
+    if (LanguagesBuffer == nullptr)
+        return TRUE;
+    if (Capacity < Required)
+    {
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+
+    CopyMemory(LanguagesBuffer, Source, Length * sizeof(WCHAR));
+    LanguagesBuffer[Length] = 0;
+    LanguagesBuffer[Length + 1] = 0;
+    return TRUE;
+}
+
+BOOL WINAPI LepGetUserPreferredUILanguages(
+    DWORD Flags,
+    PULONG NumberOfLanguages,
+    PWSTR LanguagesBuffer,
+    PULONG BufferLength
+)
+{
+    return LepGetPreferredUILanguages(Flags, NumberOfLanguages, LanguagesBuffer, BufferLength);
+}
+
+BOOL WINAPI LepGetSystemPreferredUILanguages(
