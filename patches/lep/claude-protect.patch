+            Candidates[Insert].LastWrite = LastWrite;
+            StrCopyW(Candidates[Insert].Name, Data.cFileName);
+        } while (Nt_FindNextFile(Find, &Data));
+        Nt_FindClose(Find);
+
+        if (Found == 0)
+            break;
+
+        for (Index = 0; Index < Found && Result.Deleted < LEP_LOG_RETENTION_BATCH; ++Index)
+        {
+            ULONG_PTR NameLength = StrLengthW(Candidates[Index].Name);
+
