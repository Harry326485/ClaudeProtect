diff --git a/LocaleEmulatorPlus/Hooks/WinrtHook.cpp b/LocaleEmulatorPlus/Hooks/WinrtHook.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8463ee265684048fd16116eb6bfe0aa42c1b8865
--- /dev/null
+++ b/LocaleEmulatorPlus/Hooks/WinrtHook.cpp
@@ -0,0 +1,165 @@
+#include "stdafx.h"
+#include <windows.system.userprofile.h>
+
+using namespace Mp;
+using LanguageView = ABI::Windows::Foundation::Collections::IVectorView<HSTRING>;
+using Preferences = ABI::Windows::System::UserProfile::IGlobalizationPreferencesStatics;
+
+namespace {
+using CreateStringFn = HRESULT(WINAPI*)(PCWSTR, UINT32, HSTRING*);
+using DeleteStringFn = HRESULT(WINAPI*)(HSTRING);
+using StringBufferFn = PCWSTR(WINAPI*)(HSTRING, UINT32*);
+using TaskAllocFn = PVOID(WINAPI*)(SIZE_T);
+using ActivationFn = HRESULT(WINAPI*)(HSTRING, REFIID, PVOID*);
+CreateStringFn createString;
+DeleteStringFn deleteString;
+StringBufferFn stringBuffer;
+TaskAllocFn taskAlloc;
+
+template<class Interface> class Inspectable : public Interface {
+    volatile LONG references = 1;
+protected:
+    virtual ~Inspectable() = default;
+public:
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void** value) override {
+        if (!value) return E_POINTER;
+        *value = nullptr;
+        if (iid != __uuidof(IUnknown) && iid != __uuidof(IInspectable) && iid != __uuidof(Interface))
+            return E_NOINTERFACE;
+        *value = static_cast<Interface*>(this);
+        AddRef();
+        return S_OK;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return InterlockedIncrement(&references); }
+    ULONG STDMETHODCALLTYPE Release() override {
+        ULONG remaining = InterlockedDecrement(&references);
+        if (!remaining) delete this;
+        return remaining;
+    }
+    HRESULT STDMETHODCALLTYPE GetIids(ULONG* count, IID** values) override {
+        if (!count || !values) return E_POINTER;
+        *count = 0;
+        *values = static_cast<IID*>(taskAlloc(sizeof(IID)));
+        if (!*values) return E_OUTOFMEMORY;
+        **values = __uuidof(Interface);
+        *count = 1;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetRuntimeClassName(HSTRING* value) override {
+        if (!value) return E_POINTER;
+        return createString(L"", 0, value);
+    }
+    HRESULT STDMETHODCALLTYPE GetTrustLevel(TrustLevel* value) override {
+        if (!value) return E_POINTER;
+        *value = BaseTrust;
+        return S_OK;
+    }
+};
+
+class VirtualLanguages final : public Inspectable<LanguageView> {
+    WCHAR locale[LOCALE_NAME_MAX_LENGTH]{};
+public:
+    explicit VirtualLanguages(PCWSTR name) { StrCopyW(locale, name); }
+    HRESULT STDMETHODCALLTYPE GetAt(UINT32 index, HSTRING* value) override {
+        if (!value) return E_POINTER;
+        *value = nullptr;
+        if (index != 0) return E_BOUNDS;
+        return createString(locale, (UINT32)StrLengthW(locale), value);
+    }
+    HRESULT STDMETHODCALLTYPE get_Size(UINT32* value) override {
+        if (!value) return E_POINTER;
+        *value = 1;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE IndexOf(HSTRING value, UINT32* index, boolean* found) override {
+        if (!index || !found) return E_POINTER;
+        *index = 0;
+        UINT32 length = 0;
+        PCWSTR name = stringBuffer(value, &length);
+        *found = length == StrLengthW(locale) && memcmp(name, locale, length * sizeof(WCHAR)) == 0;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE GetMany(UINT32 start, UINT32 capacity, HSTRING* values,
+                                       UINT32* actual) override {
+        if (!actual || (capacity && !values)) return E_POINTER;
+        *actual = 0;
+        if (start > 1) return E_BOUNDS;
+        if (start == 1 || !capacity) return S_OK;
+        HRESULT hr = GetAt(0, values);
+        if (SUCCEEDED(hr)) *actual = 1;
+        return hr;
+    }
+};
+
+class VirtualPreferences final : public Inspectable<Preferences> {
+    Preferences* original;
+public:
+    explicit VirtualPreferences(Preferences* value) : original(value) {}
+    ~VirtualPreferences() override { original->Release(); }
+    HRESULT STDMETHODCALLTYPE get_Languages(LanguageView** value) override {
+        if (!value) return E_POINTER;
+        *value = nullptr;
+        WCHAR name[LOCALE_NAME_MAX_LENGTH]{};
+        if (!LCIDToLocaleName(LepGetGlobalData()->GetEnvironment()->LocaleId, name, countof(name), 0))
+            return E_FAIL;
+        *value = new VirtualLanguages(name);
+        if (!*value) return E_OUTOFMEMORY;
+        WriteLog(L"WinRT GlobalizationPreferences.Languages virtual override: %ws", name);
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE get_Calendars(LanguageView** value) override { return original->get_Calendars(value); }
+    HRESULT STDMETHODCALLTYPE get_Clocks(LanguageView** value) override { return original->get_Clocks(value); }
+    HRESULT STDMETHODCALLTYPE get_Currencies(LanguageView** value) override { return original->get_Currencies(value); }
+    HRESULT STDMETHODCALLTYPE get_HomeGeographicRegion(HSTRING* value) override { return original->get_HomeGeographicRegion(value); }
+    HRESULT STDMETHODCALLTYPE get_WeekStartsOn(ABI::Windows::Globalization::DayOfWeek* value) override { return original->get_WeekStartsOn(value); }
+};
+
+HRESULT WINAPI LepRoGetActivationFactory(HSTRING classId, REFIID iid, PVOID* value) {
+    auto original = reinterpret_cast<ActivationFn>(LepGetGlobalData()->HookStub.StubRoGetActivationFactory);
+    HRESULT hr = original(classId, iid, value);
+    if (FAILED(hr) || !value || !*value || iid != __uuidof(Preferences)) return hr;
+    UINT32 length = 0;
+    PCWSTR name = stringBuffer(classId, &length);
+    static const WCHAR target[] = L"Windows.System.UserProfile.GlobalizationPreferences";
+    if (length != countof(target) - 1 || memcmp(name, target, length * sizeof(WCHAR)) != 0) return hr;
+    auto wrapped = new VirtualPreferences(static_cast<Preferences*>(*value));
+    if (!wrapped) {
+        static_cast<Preferences*>(*value)->Release();
+        *value = nullptr;
+        return E_OUTOFMEMORY;
+    }
+    *value = static_cast<Preferences*>(wrapped);
+    return S_OK;
+}
+} // namespace
+
+// The SDK's collection template references this helper even with GetMany
+// overridden. Resolve it at runtime, as Core is manually mapped before WinRT
+// loads and must not introduce a combase import into its bootstrap.
+extern "C" HRESULT WINAPI WindowsDeleteString(HSTRING value) {
+    return deleteString(value);
+}
+
+NTSTATUS LepGlobalData::HookCombaseRoutines(PVOID module) {
+    if (GetEnvironment()->HookUILanguageMode != 2 || HookStub.StubRoGetActivationFactory)
+        return STATUS_SUCCESS;
+    createString = reinterpret_cast<CreateStringFn>(GetRoutineAddress(module, "WindowsCreateString"));
+    deleteString = reinterpret_cast<DeleteStringFn>(GetRoutineAddress(module, "WindowsDeleteString"));
+    stringBuffer = reinterpret_cast<StringBufferFn>(GetRoutineAddress(module, "WindowsGetStringRawBuffer"));
+    taskAlloc = reinterpret_cast<TaskAllocFn>(GetRoutineAddress(module, "CoTaskMemAlloc"));
+    PVOID factory = GetRoutineAddress(module, "RoGetActivationFactory");
+    if (!createString || !deleteString || !stringBuffer || !taskAlloc || !factory) return STATUS_PROCEDURE_NOT_FOUND;
+    Mp::PATCH_MEMORY_DATA patches[] = {
+        Mp::FunctionJumpVa(factory, LepRoGetActivationFactory,
+                           &HookStub.StubRoGetActivationFactory, LEP_FUNCTION_JUMP_OP),
+    };
+    NTSTATUS status = Mp::PatchMemory(patches, countof(patches));
+    WriteLog(L"hook WinRT globalization activation: %08X", status);
+    return status;
+}
+
+NTSTATUS LepGlobalData::UnHookCombaseRoutines() {
+    Mp::RestoreMemory(HookStub.StubRoGetActivationFactory);
+    HookStub.StubRoGetActivationFactory = nullptr;
+    return STATUS_SUCCESS;
+}
