+inline BOOLEAN LepEqualNoCase(PCWSTR Left, PCWSTR Right)
+{
+    for (;; ++Left, ++Right)
+    {
+        WCHAR A = *Left;
+        WCHAR B = *Right;
+
+        if (A >= L'A' && A <= L'Z')
+            A += L'a' - L'A';
+        if (B >= L'A' && B <= L'Z')
+            B += L'a' - L'A';
+        if (A != B)
+            return FALSE;
+        if (A == 0)
+            return TRUE;
+    }
+}
+
+inline BOOLEAN LepHasLogSuffix(PCWSTR Name)
+{
+    static const WCHAR TxtSuffix[] = L".log.txt";
+    static const WCHAR LogSuffix[] = L".log";
+    ULONG_PTR Length = StrLengthW(Name);
+
+    if (Length >= CONST_STRLEN(TxtSuffix) &&
+        LepEqualNoCase(Name + Length - CONST_STRLEN(TxtSuffix), TxtSuffix))
+        return TRUE;
+
+    if (Length >= CONST_STRLEN(LogSuffix) &&
+        LepEqualNoCase(Name + Length - CONST_STRLEN(LogSuffix), LogSuffix))
+        return TRUE;
+
+    return FALSE;
+}
