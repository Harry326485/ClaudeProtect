+    Result.Scanned = TRUE;
+    do
+    {
+        if (Data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            continue;
+        if (!LepHasLogSuffix(Data.cFileName))
+            continue;
+        if (LepEqualNoCase(Data.cFileName, TargetName))
+            continue;
+        ++Result.Count;
+    } while (Nt_FindNextFile(Find, &Data));
+    Nt_FindClose(Find);
+
+    if (Result.Count < LEP_LOG_RETENTION_LIMIT)
+        return Result;
+
+    while (Result.Deleted < LEP_LOG_RETENTION_BATCH)
+    {
+        LEP_LOG_CANDIDATE Candidates[LEP_LOG_RETENTION_BATCH];
+        ULONG_PTR Need = LEP_LOG_RETENTION_BATCH - Result.Deleted;
+        ULONG_PTR Found = 0;
+        ULONG_PTR DeletedThisPass = 0;
+        ULONG_PTR Index;
+        ULONGLONG FailedBound = 0;
+        BOOLEAN Failed = FALSE;
+
+        Find = Nt_FindFirstFile(Pattern, &Data);
+        if (Find == INVALID_HANDLE_VALUE)
+            break;
+
+        do
+        {
+            ULONGLONG LastWrite;
+            ULONG_PTR Insert;
+
+            if (Data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+                continue;
+            if (!LepHasLogSuffix(Data.cFileName))
+                continue;
+            if (LepEqualNoCase(Data.cFileName, TargetName))
+                continue;
+
+            LastWrite = ((ULONGLONG)Data.ftLastWriteTime.dwHighDateTime << 32) |
+                        Data.ftLastWriteTime.dwLowDateTime;
+            if (!FirstPass && LastWrite <= LowerBound)
+                continue;
+
+            Insert = Found;
+            while (Insert != 0 && Candidates[Insert - 1].LastWrite > LastWrite)
+                --Insert;
+            if (Insert >= Need)
+                continue;
+            if (Found < Need)
+                ++Found;
+            for (Index = Found - 1; Index > Insert; --Index)
