+inline LEP_LOG_RETENTION_RESULT LepTrimLogDirectory(PCWSTR TargetPath)
+{
+    LEP_LOG_RETENTION_RESULT Result = {};
+    WCHAR Directory[MAX_NTPATH];
+    WCHAR Pattern[MAX_NTPATH + 2];
+    WCHAR FullPath[MAX_NTPATH];
+    WIN32_FIND_DATAW Data;
+    ULONG_PTR DirectoryLength;
+    PCWSTR TargetName;
+    HANDLE Find;
+    ULONGLONG LowerBound = 0;
+    BOOLEAN FirstPass = TRUE;
+
+    if (TargetPath == nullptr)
+        return Result;
+
+    DirectoryLength = StrLengthW(TargetPath);
+    while (DirectoryLength != 0 && TargetPath[DirectoryLength - 1] != L'\\')
+        --DirectoryLength;
+    if (DirectoryLength == 0 || DirectoryLength + 2 > countof(Pattern) ||
+        DirectoryLength >= countof(Directory))
+        return Result;
+
+    CopyMemory(Directory, TargetPath, DirectoryLength * sizeof(WCHAR));
+    Directory[DirectoryLength] = 0;
+    TargetName = TargetPath + DirectoryLength;
+
+    CopyMemory(Pattern, Directory, DirectoryLength * sizeof(WCHAR));
+    Pattern[DirectoryLength] = L'*';
+    Pattern[DirectoryLength + 1] = 0;
+
+    Find = Nt_FindFirstFile(Pattern, &Data);
